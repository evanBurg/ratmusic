{
  "name": "discord-music-bot",
  "version": "1.0.0",
  "description": "Personal Discord music bot with slash commands, yt-dlp, and admin web panel",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "admin": "node src/web/server.js",
