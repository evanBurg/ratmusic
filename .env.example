# Discord bot credentials — fill these in
DISCORD_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-client-id
DISCORD_GUILD_ID=your-guild-id

# Admin web panel
ADMIN_PORT=8787
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please
# Bind address: 0.0.0.0 = LAN-accessible, 127.0.0.1 = localhost only
ADMIN_BIND=0.0.0.0

# yt-dlp binary location (absolute path recommended)
YTDLP_PATH=/home/kev/.local/bin/yt-dlp

# Logging
LOG_LEVEL=info

# systemd service names (used by admin panel restart/stop buttons)
BOT_SERVICE=ratmusic.service
ADMIN_SERVICE=ratmusic-admin.service
