[Unit]
Description=Discord Music Bot - Admin Web Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/discord-music-bot
EnvironmentFile=%h/discord-music-bot/.env
ExecStart=/bin/bash -lc 'exec node src/web/server.js'
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
